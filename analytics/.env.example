# ─────────────────────────────────────────────────────────────────────────────
# RUBIES Analytics Automation — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Your GA4 property ID (found in GA4 → Admin → Property Settings)
GA4_PROPERTY_ID=363593585

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# 365-day summary spreadsheet (separate sheet; used by npm run fetch-365)
# Share the sheet with your service account email (Editor) so the script can write to it.
GOOGLE_SHEET_ID_365=14etPTeaCCAuGiAd9vWFRiAdNe9GU_LaKzmIJZgheiiY

# The name of your Google Sheet (the document title, not the tab name)
GOOGLE_SHEET_NAME=RUBIES SEO Tracker

# Path to your service account JSON key file (relative to the analytics/ directory)
SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Your verified site URL in Google Search Console (must match exactly)
SEARCH_CONSOLE_SITE_URL=sc-domain:rubyshines.com

# Shopify Admin API — use either (A) or (B), not both
# (A) Token-only (Custom App): set SHOPIFY_ACCESS_TOKEN
# (B) API key + password (same as rubies-utilities / legacy Private App): set SHOPIFY_API_KEY and SHOPIFY_PASSWORD
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-admin-api-token
# SHOPIFY_API_KEY=your-api-key
# SHOPIFY_PASSWORD=your-api-password
SHOPIFY_API_VERSION=2024-01
