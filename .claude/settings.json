{
  "permissions": {
    "allow": [
      "WebFetch(domain:codepen.io)",
      "WebFetch(domain:lukeplant.me.uk)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:defensivecss.dev)",
      "Edit(*)",
      "Write(.claude/memory/*)",
      "Bash(rm .claude/memory/*)",
      "mcp__rubies-cs__get_order_details",
      "mcp__rubies-cs__donation_partner_list",
      "mcp__rubies-cs__donation_partner_publish"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-edits.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-checkout-git.js\""
          }
        ]
      }
    ]
  }
}
