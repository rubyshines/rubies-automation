# ─────────────────────────────────────────────────────────────────────────────
# RUBIES Automations — Environment Variables (root)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values. Used by seo-tracking/backfill.js and any root-level scripts.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (required for backfill)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: direct Postgres connection for creating tables from the script.
# If not set, run the SQL in seo-tracking/supabase-schema.sql once in Supabase SQL Editor.
SUPABASE_DATABASE_URL=

# Google (match analytics auth: path to service account JSON key file)
SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# Your verified site URL in Google Search Console
SEARCH_CONSOLE_SITE_URL=sc-domain:rubyshines.com

# GA4 property ID (for backfill GA4 data)
GA4_PROPERTY_ID=

# Shopify (API key + password — legacy Private App)
SHOPIFY_STORE_URL=
SHOPIFY_API_KEY=
SHOPIFY_PASSWORD=

# Not used by backfill; include for consistency with other automations
SENDGRID_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Wholesale / Retailer Lead Gen
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL and SUPABASE_SERVICE_KEY already set above
# SERVICE_ACCOUNT_KEY_PATH already set above

GOOGLE_MAPS_API_KEY=
WHOLESALE_SHEET_ID=
ANTHROPIC_API_KEY=
# AI_MODEL= (default: claude-haiku-4-5-20251001)
# SCORE_THRESHOLD= (default: 5)

# ─────────────────────────────────────────────────────────────────────────────
# Klaviyo (email marketing stats + campaign content)
# ─────────────────────────────────────────────────────────────────────────────
KLAVIYO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Judge.me (product reviews)
# ─────────────────────────────────────────────────────────────────────────────
JUDGEME_API_TOKEN=
# JUDGEME_SHOP_DOMAIN= (defaults to SHOPIFY_STORE_URL if not set)

# ─────────────────────────────────────────────────────────────────────────────
# Customer Service AI (knowledge base + conversation search)
# ─────────────────────────────────────────────────────────────────────────────
# Voyage AI — embeddings for semantic search (sign up at voyageai.com)
VOYAGE_API_KEY=

# Gorgias — import historical customer service conversations
GORGIAS_DOMAIN=             # e.g. rubies (from rubies.gorgias.com)
GORGIAS_API_KEY=            # Settings → REST API → HTTP Integrations
GORGIAS_EMAIL=              # Your Gorgias account email (for API auth)
SHOPIFY_ADMIN_STORE=your-admin-store-slug

# ─────────────────────────────────────────────────────────────────────────────
# QuickBooks Online (finance MCP server)
# ─────────────────────────────────────────────────────────────────────────────
# Register an app at https://developer.intuit.com → "Accounting" scope
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=                   # Set after first `npm run finance-auth`
# STATE_TAX_RATE=0.00           # Optional: state corporate tax rate for tax estimates
